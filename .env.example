# Database (PostgreSQL asyncpg format)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qr_reviews

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=optional_fallback_key
GEMINI_API_KEY_3=optional_fallback_key
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
ADMIN_SESSION_MINUTES=60

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=use_a_separate_webhook_secret
ANNUAL_PRICE_PAISE=159900
TWO_YEAR_PRICE_PAISE=249900
PHYSICAL_STAND_PRICE_PAISE=24900

# App Settings
APP_URL=http://localhost:8000
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_LOGO_BYTES=2097152
MAX_REQUEST_BYTES=3145728
MAX_WEBHOOK_BYTES=262144

# Initial super-admin seed (set the password only when creating/updating it)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_SLUG=admin

# Email / SMTP Configuration (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TLS=True
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60

# Launch gates: approve operator identity/policies and verify payments before enabling.
PUBLIC_CHECKOUT_ENABLED=False
PHYSICAL_STANDS_ENABLED=False
POLICIES_APPROVED=False
LEGAL_BUSINESS_NAME=Aurion Stack
SUPPORT_EMAIL=support@revqr.tech
SUPPORT_PHONE=+919322974288
BUSINESS_ADDRESS=Mapusa, Goa 403510, India (service location)
GRIEVANCE_CONTACT_NAME=
SHIPPING_ESTIMATE=Approximately 7 business days from order confirmation, subject to production and courier availability.
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=

# Use a private Redis TLS URL in production; memory storage is per process.
RATE_LIMIT_STORAGE_URI=memory://
AI_MONTHLY_LIMIT=1000
AI_DAILY_BUSINESS_LIMIT=100
AI_SCAN_LIMIT=5
AI_GLOBAL_DAILY_CALL_LIMIT=3000
AI_GLOBAL_DAILY_TOKEN_BUDGET=2000000
SENTRY_DSN=
